{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "wordroom-cloud",
  "main": "worker.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wordroom-cloud",
      "database_id": "8cdbec8b-672d-4183-a999-cfb52c7e6c50",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "REQUEST_LIMIT",
      "namespace_id": "2001",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "WRITE_LIMIT",
      "namespace_id": "2002",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://ctrlcctrlvisthebest.github.io,http://127.0.0.1:4173,http://localhost:4173",
  },
}
